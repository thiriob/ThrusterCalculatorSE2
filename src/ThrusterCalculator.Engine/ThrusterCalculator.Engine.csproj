<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The ONLY project allowed to load Space Engineers 2's own assemblies.

    It exists for one reason: contentcache.vrb carries the game's precomputed block occupancy for
    ~1,450 blocks (Research.md §4.0.0), which is otherwise unobtainable and would have to be
    hand-maintained per block.

    Producer-side only. Nothing here is visible to Model, Core or the GUI — the consumer still
    needs nothing but gamedata.json.
  -->
  <PropertyGroup>
    <TargetFramework>$(TcWindowsTargetFramework)</TargetFramework>
    <RootNamespace>ThrusterCalculator.Engine</RootNamespace>
    <!--
      SpaceEngineers2.runtimeconfig.json requires Microsoft.WindowsDesktop.App, and the game
      assemblies bind against it once loaded in-process. UseWPF pulls that shared framework in;
      without it the engine types fail to resolve at runtime.

      UseWindowsForms is needed too, and only shows up in a SELF-CONTAINED publish. A framework
      -dependent build finds System.Windows.Forms lying on disk next to WPF, so a dev machine never
      notices; publishing self-contained trims the runtime to what the app declares, and hosting
      then fails with "Could not load file or assembly 'System.Windows.Forms'". The producer
      degrades rather than crashing, so the symptom is not an error — it is a quietly worse config:
      occupancy falls back to the 16-entry table, inheritance resolves nothing, and every planet
      loses its surface gravity. Caught only by publishing and running `tc extract` from the output.
    -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF swaps in the WPF implicit-using set, which drops these. Put them back. -->
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Collections.Generic" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThrusterCalculator.Extraction\ThrusterCalculator.Extraction.csproj" />
  </ItemGroup>

</Project>
