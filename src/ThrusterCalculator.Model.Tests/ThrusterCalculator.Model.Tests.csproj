<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Contract tests. The schema is the interface between the two halves of the app (Technic.md §1),
    so it gets its own suite rather than riding along in Core.Tests, which is about the math.

    Runs green on a clean clone with no Space Engineers 2 installed.
  -->
  <PropertyGroup>
    <TargetFramework>$(TcTargetFramework)</TargetFramework>
    <RootNamespace>ThrusterCalculator.Model.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\tests\fixtures\synthetic-gamedata.json"
             Link="fixtures\synthetic-gamedata.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThrusterCalculator.Model\ThrusterCalculator.Model.csproj" />
  </ItemGroup>

</Project>
