<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ThrusterCalculator.Gui.ViewModels"
        xmlns:c="using:ThrusterCalculator.Gui.Controls"
        mc:Ignorable="d" d:DesignWidth="1500" d:DesignHeight="800"
        x:Class="ThrusterCalculator.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ThrusterCalculator SE2"
        Width="1500" Height="820"
        MinWidth="1150" MinHeight="620"
        FontSize="14">

    <Window.Resources>
        <!-- One configurator row. Fixed widths rather than a star between label and field: a star
             pushed the spinner to the far edge of its column, leaving the number stranded away
             from the size it belongs to. -->
        <DataTemplate x:Key="ConfiguratorRow" DataType="vm:ConfiguratorRowViewModel">
            <Grid ColumnDefinitions="46,140,136,*" Margin="0,0,0,6" Height="34">
                <TextBlock Grid.Column="0" Classes="cell" Text="{Binding SizeText}" />
                <!-- What one more actually buys. Without this the shortfall appears to move by the
                     wrong amount. -->
                <TextBlock Grid.Column="1" Classes="cell dim" Margin="0,0,8,0"
                           Text="{Binding NetContributionText}" />
                <c:CountInput Grid.Column="2" Value="{Binding Count}" />
            </Grid>
        </DataTemplate>

        <!-- One template, two instances: "if you use one type" against a bare ship, and "to cover
             what's left" against the shortfall the loadout leaves. Same component, different
             requirement fed in — which is a decent sign the model underneath is right.

             Narrower than the old full-width table, so covered range and draw move to the row
             tooltip; count, added mass and achieved TWR are what you actually choose between. -->
        <DataTemplate x:Key="ThrusterTable" DataType="vm:ThrusterTableViewModel">
            <StackPanel>
                <Grid ColumnDefinitions="56,40,100,54,*" Margin="10,0,10,2">
                    <TextBlock Grid.Column="1" Classes="col" Text="No." />
                    <TextBlock Grid.Column="2" Classes="col" Text="ADDED MASS" />
                    <TextBlock Grid.Column="3" Classes="col" Text="TWR" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Families}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThrusterFamilyViewModel">
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding Name}" Classes="family" Margin="10,4,0,2" />
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ThrusterResultViewModel">
                                            <Grid ColumnDefinitions="56,40,100,54,*" Margin="10,0,10,0"
                                                  Height="24" ToolTip.Tip="{Binding DetailText}">
                                                <TextBlock Grid.Column="0" Classes="cell"
                                                           Text="{Binding SizeText}" />
                                                <TextBlock Grid.Column="1" Classes="cell num"
                                                           Text="{Binding Count}" />
                                                <TextBlock Grid.Column="2" Classes="cell num"
                                                           Text="{Binding AddedMassText}" />
                                                <TextBlock Grid.Column="3" Classes="cell num"
                                                           Text="{Binding RatioText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="dim" Margin="10,4,0,0" IsVisible="{Binding IsEmpty}"
                           Text="Nothing here can do it alone." />

                <!-- Collapsed, never hidden: on an atmospheric world "the ion family is dead here"
                     is among the most useful things the panel says. -->
                <Expander IsVisible="{Binding HasUnusable}" Margin="0,4,0,0"
                          Header="{Binding UnusableSummary}">
                    <ItemsControl ItemsSource="{Binding Unusable}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ThrusterResultViewModel">
                                <Grid ColumnDefinitions="150,*" Margin="0,1">
                                    <TextBlock Grid.Column="0" Classes="cell" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Classes="dim"
                                               VerticalAlignment="Center" Text="{Binding StatusText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- Sizes are set relative to the window's 14px base rather than left to the theme
             defaults, which assume a scaled display; at 100% Windows scaling they read small. -->
        <Style Selector="TextBlock.h">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style Selector="TextBlock.h.boxed">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBlock.dim">
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Applied conditionally, to show a value is present but not in force. -->
        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="TextBlock.groupHeader">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- Results table. Numeric columns are right-aligned and tabular so digits line up
             vertically; that alignment is what makes the panel scannable at all. -->
        <Style Selector="TextBlock.col">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="TextBlock.cell">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.num">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontFeatures" Value="tnum" />
        </Style>
        <Style Selector="TextBlock.family">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="Margin" Value="0,6,0,3" />
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- Sample data must be unmistakable: the numbers are invented. -->
        <Border DockPanel.Dock="Top" Padding="12,8" Background="#7A5200"
                IsVisible="{Binding IsSampleData}">
            <TextBlock TextWrapping="Wrap" Foreground="White">
                <Run Text="Sample data — these are not real Space Engineers 2 values." FontWeight="SemiBold" />
                <Run Text="{Binding SampleDataAdvice}" />
            </TextBlock>
        </Border>

        <!-- Data panel (Design §4.5.1): thin and unglamorous, desktop-only, and it degrades to an
             explanation rather than a dead button when tc.exe or the game is absent. -->
        <Border DockPanel.Dock="Bottom" Padding="12,6"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}">
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0" Classes="dim" VerticalAlignment="Center"
                               Text="{Binding DataStatus}" />
                    <Button Grid.Column="1" Content="Rebuild" Margin="8,0,0,0"
                            IsVisible="{Binding CanRebuild}"
                            IsEnabled="{Binding !IsRebuilding}"
                            Command="{Binding RebuildCommand}" />
                    <Button Grid.Column="2" Content="Cancel" Margin="6,0,0,0"
                            IsVisible="{Binding IsRebuilding}"
                            Command="{Binding CancelRebuildCommand}" />
                </Grid>

                <!-- Patch day is the exact scenario this app exists for, so stale data must never
                     be served quietly. -->
                <TextBlock Classes="dim" TextWrapping="Wrap" Foreground="#D08A3E"
                           IsVisible="{Binding IsStale}"
                           Text="{Binding StalenessMessage}" />

                <TextBlock Classes="dim" TextWrapping="Wrap"
                           IsVisible="{Binding DataMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Text="{Binding DataMessage}" />

                <TextBlock Classes="dim" TextWrapping="Wrap"
                           IsVisible="{Binding ShowRebuildUnavailable}"
                           Text="{Binding RebuildUnavailableMessage}" />

                <TextBlock Classes="dim" TextWrapping="Wrap"
                           IsVisible="{Binding HasExtractionWarnings}"
                           Text="{Binding ExtractionWarningSummary}" />
            </StackPanel>
        </Border>

        <!-- Inputs | configurator | reference. The configurator is the answer now; the tables on
             the right are the rule of thumb you check it against. -->
        <Grid ColumnDefinitions="360,*,360" Margin="12">

            <!-- ── inputs ─────────────────────────────────────────────── -->
            <ScrollViewer Grid.Column="0" Margin="0,0,12,0"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <Border Classes="card">
                        <!-- One label column width across all three rows, so the fields line up
                             instead of each starting wherever its own label happens to end. -->
                        <StackPanel Spacing="8">
                            <TextBlock Classes="h boxed" Text="DEPARTURE" />
                            <TextBlock Classes="h" Text="GRAVITY" Margin="0,0,0,2" />
                            <Grid ColumnDefinitions="78,*,Auto">
                                <TextBlock Grid.Column="0" Text="Planet" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0"
                                          ItemsSource="{Binding PlanetItems}"
                                          SelectedItem="{Binding SelectedPlanetItem}"
                                          HorizontalAlignment="Stretch">
                                    <!-- Headings are rows, not selectable ones. The view model
                                         rejects them too, since a failed style binding is silent. -->
                                    <ComboBox.Styles>
                                        <Style Selector="ComboBoxItem" x:DataType="vm:PlanetListItem">
                                            <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                                        </Style>
                                    </ComboBox.Styles>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PlanetListItem">
                                            <TextBlock Text="{Binding Label}"
                                                       Classes.groupHeader="{Binding !IsSelectable}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <!-- The gravity actually in force, shown as a figure rather than in
                                 the entry box. Binding the only visible field to the override made
                                 selecting a planet change the maths without changing anything on
                                 screen, which reads as a bug. -->
                            <!-- The planet's own gravity, dimmed while the override is in force.
                                 Exactly one of this and the custom field below is live at a time,
                                 so which number is being used is readable at a glance. -->
                            <Grid ColumnDefinitions="78,*">
                                <TextBlock Grid.Column="0" Text="Gravity" VerticalAlignment="Center"
                                           Classes.muted="{Binding GravityIsCustom}" />
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="16"
                                           VerticalAlignment="Center"
                                           Classes.muted="{Binding GravityIsCustom}"
                                           Text="{Binding GravityText}" />
                            </Grid>

                            <TextBlock Classes="dim" TextWrapping="Wrap"
                                       Text="{Binding GravityNote}" />

                            <!-- The producer's own warnings, against the planet they concern.
                                 Schema §6: a degraded extraction has to be visible, or the app
                                 serves confident wrong answers. -->
                            <TextBlock Classes="dim" TextWrapping="Wrap" Foreground="#D08A3E"
                                       IsVisible="{Binding HasPlanetWarning}"
                                       Text="{Binding PlanetWarningText}" />

                            <!-- Forced on, and locked, when the planet states no gravity of its
                                 own: there is nothing to fall back to. -->
                            <CheckBox Content="Use a custom gravity" Margin="0,4,0,0"
                                      IsChecked="{Binding GravityIsCustom, Mode=TwoWay}"
                                      IsEnabled="{Binding CanUsePlanetGravity}" />

                            <Grid ColumnDefinitions="78,*,Auto" Margin="0,0,0,6">
                                <NumericUpDown Grid.Column="1" Margin="8,0"
                                               Value="{Binding CustomGravity}"
                                               IsEnabled="{Binding GravityIsCustom}"
                                               Minimum="0.1" Maximum="100" Increment="0.1"
                                               FormatString="0.00" />
                                <TextBlock Grid.Column="2" Text="m/s²" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Gravity and TWR are unrelated inputs; without a break they read as
                                 one block of numbers. -->
                            <Separator Margin="0,2,0,6" />

                            <TextBlock Classes="h" Text="THRUST TARGET" Margin="0,0,0,2" />
                            <Grid ColumnDefinitions="78,*,Auto">
                                <TextBlock Grid.Column="0" Text="Target TWR" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0"
                                               Value="{Binding TargetThrustToWeight}"
                                               Minimum="0.1" Maximum="20" Increment="0.1"
                                               FormatString="0.0" />
                            </Grid>
                            <TextBlock Classes="dim" TextWrapping="Wrap"
                                       Text="Thrust ÷ weight. 1.0 hovers, 1.5 lifts off comfortably." />
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="h boxed" Text="SHIP MASS" />
                            <!-- Each option binds two-way to its own settable property. A negated
                                 binding cannot write back, which left this group unclickable. -->
                            <RadioButton GroupName="mass" Content="I know it"
                                         IsChecked="{Binding IsDirectMode, Mode=TwoWay}" />
                            <c:MassInput Value="{Binding DirectMassKg}"
                                         IsEnabled="{Binding IsDirectMode}" />
                            <TextBlock Classes="dim" Text="kilograms, as shown in game" />

                            <RadioButton GroupName="mass" Content="Work it out from storage"
                                         IsChecked="{Binding IsStorageMode, Mode=TwoWay}" Margin="0,8,0,0" />
                            <StackPanel IsEnabled="{Binding IsStorageMode}" Spacing="6">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="Hull" VerticalAlignment="Center" />
                                    <c:MassInput Grid.Column="1" Margin="8,0,0,0"
                                                 Value="{Binding HullMassKg}" />
                                </Grid>
                                <TextBlock Classes="dim" Text="kilograms, excluding cargo and thrusters" />

                                <ItemsControl ItemsSource="{Binding Containers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StorageRowViewModel">
                                            <Grid ColumnDefinitions="*,118" Margin="0,2">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Classes="dim" Text="{Binding CapacityText}" />
                                                </StackPanel>
                                                <NumericUpDown Grid.Column="1" Minimum="0" Maximum="999"
                                                               Value="{Binding Count}" FormatString="0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Tanks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StorageRowViewModel">
                                            <Grid ColumnDefinitions="*,118" Margin="0,2">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Classes="dim" Text="{Binding BlockMassText}" />
                                                </StackPanel>
                                                <NumericUpDown Grid.Column="1" Minimum="0" Maximum="999"
                                                               Value="{Binding Count}" FormatString="0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Classes="dim" TextWrapping="Wrap"
                                           Text="Tanks count their block mass only — gas is massless in game, so a full tank weighs the same as an empty one." />
                            </StackPanel>

                            <!-- The number everything downstream is computed from. It was only
                                 visible as three preset figures in the middle column, which left
                                 the panel you type into with no total of its own. -->
                            <Separator Margin="0,4" />
                            <Grid ColumnDefinitions="78,*">
                                <TextBlock Grid.Column="0" Text="Total" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="16"
                                           VerticalAlignment="Center"
                                           Text="{Binding ShipMassText}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ── configurator: the answer ─────────────────────────────── -->
            <DockPanel Grid.Column="1" Margin="0,0,12,0">

                <StackPanel DockPanel.Dock="Top">
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="h boxed" Text="LOAD"
                                       IsVisible="{Binding IsStorageMode}" />
                            <StackPanel Spacing="8" IsVisible="{Binding IsStorageMode}">
                                <ListBox ItemsSource="{Binding PresetNames}"
                                         SelectedIndex="{Binding SelectedPresetIndex}"
                                         HorizontalAlignment="Left">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>

                                <!-- All three shown at once: the failure this app exists to prevent
                                     is the ship that lifts empty and strands full. -->
                                <ItemsControl ItemsSource="{Binding Loads}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="18" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LoadSummary">
                                            <StackPanel>
                                                <TextBlock Classes="dim" Text="{Binding Name}" />
                                                <TextBlock Text="{Binding MassText}" FontSize="16" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock>
                                <Run Text="Needs" />
                                <Run Text="{Binding RequirementText}" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- The running total, pinned below the list so it never scrolls out of sight —
                     it is the thing you are steering by. -->
                <StackPanel DockPanel.Dock="Bottom">

                    <!-- MOCKUP (Roadmap v3). Fixed invented data; does not react to anything. -->
                    <Border Classes="card" Margin="0,8,0,0">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="h boxed" Text="CLIMB PROFILE" />
                                <Border Grid.Column="1" Background="#7A5200" CornerRadius="3"
                                        Padding="6,1" Margin="0,0,0,6" VerticalAlignment="Top">
                                    <TextBlock Text="MOCKUP" FontSize="10" Foreground="White" />
                                </Border>
                            </Grid>

                            <c:ClimbProfileChart Height="230"
                                                 Samples="{Binding ClimbSamples}"
                                                 BandLabels="{Binding ClimbBands}"
                                                 TargetRatio="{Binding TargetThrustToWeight}" />

                            <TextBlock Classes="dim" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="{Binding ClimbCaption}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Margin="0,8,0,0">
                        <StackPanel Spacing="6">
                            <ProgressBar Minimum="0" Maximum="1" Height="6"
                                         Value="{Binding LoadoutFraction}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="dim"
                                           Text="{Binding LoadoutSummary}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Margin="8,0,0,0"
                                           Text="{Binding ShortfallText}" />
                            </Grid>
                            <TextBlock Classes="dim" TextWrapping="Wrap" Foreground="#D08A3E"
                                       IsVisible="{Binding LoadoutHasUnknownMass}"
                                       Text="&#x26A0; A placed thruster has unknown mass, so the requirement above is understated." />
                        </StackPanel>
                    </Border>
                    <TextBlock Classes="dim" Margin="0,6,0,0" Text="{Binding Assumption}" />
                </StackPanel>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <Border Classes="card">
                      <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="h boxed" Text="CONFIGURATOR" />
                            <Button Grid.Column="1" Content="Clear" Margin="0,0,0,6"
                                    IsVisible="{Binding HasPlacedThrusters}"
                                    Command="{Binding ClearLoadoutCommand}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ConfiguratorFamilies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConfiguratorFamilyViewModel">
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Name}" Classes="family" />

                                        <!-- Two explicit columns with a rule between them, rather
                                             than a UniformGrid: the split is stable when the window
                                             resizes, and there is something to draw the line on. -->
                                        <Grid ColumnDefinitions="*,Auto,*">
                                            <ItemsControl Grid.Column="0" ItemsSource="{Binding LeftRows}"
                                                          ItemTemplate="{StaticResource ConfiguratorRow}" />

                                            <Border Grid.Column="1" Width="1" Margin="10,2"
                                                    Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

                                            <ItemsControl Grid.Column="2" ItemsSource="{Binding RightRows}"
                                                          ItemTemplate="{StaticResource ConfiguratorRow}" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                </ScrollViewer>
            </DockPanel>

            <!-- ── reference ────────────────────────────────────────────── -->
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Classes="card">
                      <StackPanel>
                        <TextBlock Classes="h boxed" Text="{Binding ConfigurationsHeading}" />
                        <ContentControl Content="{Binding SingleType}"
                                        ContentTemplate="{StaticResource ThrusterTable}" />
                      </StackPanel>
                    </Border>

                    <Border Classes="card">
                      <StackPanel>
                        <TextBlock Classes="h boxed" Text="TO COVER WHAT&apos;S LEFT" />
                        <ContentControl Content="{Binding Remaining}"
                                        ContentTemplate="{StaticResource ThrusterTable}" />
                      </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
