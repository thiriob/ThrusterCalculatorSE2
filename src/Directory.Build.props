<Project>

  <!--
    Single flip point for target frameworks.

    Pinned to net9.0 to match Space Engineers 2, NOT because net9 is current. SE2's
    SpaceEngineers2.runtimeconfig.json declares:

        "tfm": "net9.0", frameworks: Microsoft.NETCore.App 9.0.0,
                                     Microsoft.WindowsDesktop.App 9.0.0

    Matching the runtime the game was built and tested against removes a variable.

    Two TFMs, and the split is deliberate (Technic.md §2):

      TcTargetFramework         net9.0          Model, Core, Extraction, Gui, every test project
      TcWindowsTargetFramework  net9.0-windows  Engine and Cli only

    Engine hosts SE2's own assemblies to read contentcache.vrb (Technic.md §10.2.0), so it
    needs the Windows TFM plus <UseWPF>true</UseWPF>; Cli inherits that by referencing it.
    Nothing else does, and nothing else should — Model and Core staying platform-neutral is
    what keeps a web target open (Technic.md §9), and Extraction staying neutral is what
    keeps it testable with no game installed.
  -->
  <PropertyGroup>
    <TcTargetFramework>net9.0</TcTargetFramework>
    <TcWindowsTargetFramework>net9.0-windows</TcWindowsTargetFramework>
    <AvaloniaVersion>12.1.1</AvaloniaVersion>
  </PropertyGroup>

  <!--
    The single source of the release version.

    Bumping this is what publishes: pushing to main builds a release named after it, and skips if
    one already exists. So merging work to main is safe and repeatable, while *shipping* stays a
    deliberate one-line act rather than a side effect of merging.

    It also stamps the assemblies, which is what `tc` writes into gamedata.json's generator.version
    — so a config can be traced back to the build that produced it.
  -->
  <PropertyGroup>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!--
    Symbols go inside the assemblies rather than into .pdb files beside them.

    A release folder with no loose .pdb is cleaner, and anyone actually debugging will build from
    source. But symbols are still worth having: the one thing that cannot be reproduced here is a
    user's own install and game build, so a pasted stack trace is the main diagnostic channel — and
    without symbols it names methods but not lines. Embedding costs ~100 KB across all assemblies
    and removes the choice.

    Third-party native symbols are a different matter and are dropped at packaging time:
    libSkiaSharp.pdb alone is 80 MB, and nobody here is debugging Skia.
  -->
  <PropertyGroup>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
